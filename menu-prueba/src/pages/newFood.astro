---
import "../styles/global.css";
import "../styles/font.css";
import Navbar from "../layouts/navbar.astro";
import Footer from "../components/footer.astro";
import Allergens from "../components/allergens.astro";

const imageUrl = "";
const imageAlt = "";
---

<html lang="es">
  <head>
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/font.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Asap:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <title>Nombre | Agregar Nuevo Plato</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body class="w-full asap">
    <Navbar text={"Nuevo Plato"} newfood={true} />
    <form
      enctype="multipart/form-data"
      method="post"
      action="/api/new-food"
      class="max-w-xl mx-auto p-6 rounded-lg space-y-6"
    >
      <div class="flex flex-col justify-between">
        <h2 class="block text-[16px] font-medium text-gray-700 mb-1">
          Elegir imagen
        </h2>
        <div class="flex items-center justify-around h-full w-full">
          <div class="flex flex-col gap-1">
            <input
              type="file"
              name="image"
              accept="image/*"
              required
              class="block w-24 h-8 text-[10px] px-4 text-white bg-black border-gray-300 rounded-lg cursor-pointer focus:outline-none"
            />
            <button
              onclick=""
              type="button"
              class="block w-24 h-8 text-[10px] px-4 text-white bg-[#f00] border-gray-300 rounded-lg cursor-pointer focus:outline-none"
            >
              Borrar imagen
            </button>
          </div>
          <img
            src={""}
            alt={""}
            class="bg-gray-200 cover w-[10rem] h-[10rem] rounded-md border border-gray-200"
          />
        </div>
      </div>

      <div>
        <label class="block text-large font-medium text-gray-700 mb-1">
          Nombre
        </label>
        <input
          type="text"
          name="name"
          required
          class="w-full px-3 py-2 border border-gray-300 bg-white rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500"
        />
      </div>

      <div>
        <label class="block text-[16px] font-medium text-gray-700 mb-1">
          Descripción
        </label>
        <textarea
          name="description"
          required
          rows="3"
          class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white shadow-sm focus:ring-indigo-500 focus:border-indigo-500"
        ></textarea>
      </div>

      <div>
        <label class="block text-[16px] font-medium text-gray-700 mb-1">
          Precio
        </label>
        <input
          type="number"
          name="price"
          step="0.01"
          min="0"
          placeholder="$"
          required
          class="w-full px-3 py-2 border border-gray-300 bg-white rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 placeholder:text-gray-400"
        />
      </div>

      <fieldset class="">
        <legend class="text-[16px] font-medium text-gray-700 mb-2"
          >Alergenos</legend
        >
        <Allergens />
      </fieldset>

      <div>
        <button
          type="submit"
          class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Agregar Plato
        </button>
      </div>
    </form>
  </body>
  <Footer />
</html>

<style>
  html {
    background: #f6f6f6;
    text-align: left;
  }
</style>
