---
import allergens from "../data/allergens.js";
---

<div class="flex flex-wrap gap-1">
  {
    allergens.map((allergen) => (
      <label class="cursor-pointer">
        <input
          type="checkbox"
          name="allergens"
          value={allergen}
          class="peer hidden"
        />
        <span class="inline-block px-2 py-1 rounded-full border border-gray-300 text-sm text-gray-700 peer-checked:bg-indigo-100 peer-checked:text-indigo-600 peer-checked:border-indigo-600 transition-colors">
          {allergen}
        </span>
      </label>
    ))
  }
</div>
