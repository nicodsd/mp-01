  <div
    class="flex-col flex items-center"
    style="justify-content:center; gap:1rem; margin-bottom:1rem;"
  >
    <div class="">
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener"
        style="background:#E1306C; color:#fff; padding:0.5rem 1rem; border-radius:5px; text-decoration:none; width:2.6rem;"
